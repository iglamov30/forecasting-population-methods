# Copy this file to .env (or export these as real environment variables) and
# fill in your own keys. Never commit a file with real keys in it.
#
# Census API key (free): https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# BLS API key (free): https://data.bls.gov/registrationEngine/
# Optional -- the BLS API works without a key at reduced rate limits.
BLS_API_KEY=
